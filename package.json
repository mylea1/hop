{
  "name": "hop-lan",
  "version": "1.0.0",
  "description": "A little closer. Local file sharing for Mac and Windows.",
  "main": "src/main/main.js",
  "private": true,
  "author": "Hop contributors",
  "license": "MIT",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration.test.js",
    "test:ui": "node scripts/smoke-ui.js",
    "icons": "node scripts/generate-icons.js",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": { "electron": "45.1.0", "electron-builder": "26.18.0", "sharp": "0.34.5" }
}
